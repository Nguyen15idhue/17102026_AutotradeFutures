# .env.example — CHỈ placeholder, KHÔNG điền giá trị thật, KHÔNG commit file .env
# Copy: Copy-Item .env.example .env  (rồi điền giá trị thật)

# ============================================================
# Binance LIVE — chỉ cần khi chạy tiền thật
# Key: CHỈ sub-account futures, TẮT withdrawal, whitelist IP VPS
# ============================================================
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ============================================================
# Mock server (binance-demo-server) — KHÔNG cần key Binance
# Bí mật mặc định của mock là "mock-secret"; chỉ đổi nếu muốn
# ============================================================
MOCK_API_SECRET=
MOCK_MARKET_MODE=proxy

# ============================================================
# Chọn cấu hình chiến lược (file trong config/, KHÔNG chứa secret)
# Engine đọc biến này từ P1.3; mặc định mock để không bao giờ vô tình live
# ============================================================
CONFIG_PATH=config/mvp.mock.yaml          # live: config/mvp.live.yaml
BINANCE_BASE_URL=http://binance-demo-server:8080   # live: https://fapi.binance.com
BINANCE_WS_URL=ws://binance-demo-server:8080/ws    # live: wss://fstream.binance.com

# ============================================================
# Telegram bot — outbound-only, chỉ gửi vào 1 group cụ thể
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# ============================================================
# Dashboard basic auth (đổi mật khẩu mạnh)
# ============================================================
DASH_USER=
DASH_PASS=
