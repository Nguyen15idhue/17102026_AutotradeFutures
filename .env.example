# .env.example — placeholder only, KHÔNG điền giá trị thật, KHÔNG commit file .env
# Copy: cp .env.example .env  (trên VPS) rồi điền giá trị thật

# Binance (key CHỈ sub-account futures, TẮT withdrawal, whitelist IP VPS)
# Demo dùng key tạo trong demo.binance.com; live dùng key sub-account riêng
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Telegram bot — outbound-only, chỉ gửi vào 1 group cụ thể
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# Dashboard basic auth (đổi mật khẩu mạnh)
DASH_USER=
DASH_PASS=
